# MQTT Broker Configuration
# This file shows the required environment variables for MQTT connectivity.
# Copy this to .env and fill in with your actual broker details.
#
# DO NOT commit .env with real credentials!
# Only this .env.example should be in version control.

# MQTT Broker URL
# Should be a WebSocket URL (ws:// or wss://)
# Example: wss://broker.hivemq.cloud:8884/mqtt
MQTT_URL=wss://your-broker-url.com:8884/mqtt

# MQTT Broker Username
# Example: mobile_app
MQTT_USERNAME=your_mqtt_username

# MQTT Broker Password
# Example: your_secure_password_here
MQTT_PASSWORD=your_mqtt_password

# MQTT Client ID Prefix
# Used to generate unique client IDs for each session
# Final clientId will be: {prefix}-{timestamp}-{random}
# Example: smartapp
MQTT_CLIENT_ID_PREFIX=smartapp
